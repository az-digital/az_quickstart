{#
/**
 * @file
 * Template for the Form embed placeholder component.
 *
 * Shows a generic form icon, and the form's name and provider when given, in
 * place of a live embedded form. Editors see it in CKEditor's preview and in
 * the Media Library, and in Canvas's editor until they pick a form. It never
 * loads the provider's script.
 *
 * The icon is a generic form icon, never a provider's logo. Rationale: logos
 * come with trademark rules. It's an inline SVG, not an icon font or a CSS
 * background. Rationale: CKEditor's preview loads CSS but no JavaScript, and
 * an inline SVG needs neither. It's Lucide's clipboard-list icon (ISC
 * license), in the same line style as the Form embed alert's icons.
 *
 * Props:
 * - label: The form's name. The Media Library leaves it empty, because the
 *   admin theme already prints each item's name under its preview.
 * - vendor: The name of the service that hosts the form, such as Slate.
 */
#}
{% set attributes = attributes|default(create_attribute()) %}
<div{{ attributes.addClass('az-form-embed-placeholder') }}>
  <svg class="az-form-embed-placeholder__icon" xmlns="http://www.w3.org/2000/svg"
       viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
       stroke-linecap="round" stroke-linejoin="round"
       aria-hidden="true" focusable="false">
    <rect width="8" height="4" x="8" y="2" rx="1" ry="1"/>
    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
    <path d="M12 11h4"/>
    <path d="M12 16h4"/>
    <path d="M8 11h.01"/>
    <path d="M8 16h.01"/>
  </svg>
  {% if label %}
    <p class="az-form-embed-placeholder__label">{{ label }}</p>
  {% endif %}
  {% if vendor %}
    <p class="az-form-embed-placeholder__vendor">{{ vendor }}</p>
  {% endif %}
</div>
