<?php

/**
 * @file
 * Contains az_seo.module.
 */

use Drupal\Component\Serialization\Json;
use Drupal\Core\Entity\EntityTypeInterface;

/**
 * Implements hook_entity_base_field_info_alter().
 *
 * Canvas stores its own meta tag patterns on every new page, which take
 * precedence over the metatag.metatag_defaults.canvas_page config shipped by
 * this module (and use a media field Quickstart doesn't have). Keep only the
 * title, which the Canvas page form exposes, so everything else falls back to
 * the Quickstart defaults.
 */
function az_seo_entity_base_field_info_alter(array &$fields, EntityTypeInterface $entity_type) {
  if ($entity_type->id() === 'canvas_page' && isset($fields['metatags'])) {
    $fields['metatags']->setDefaultValue(Json::encode([
      'title' => '[canvas_page:title] | [site:name]',
    ]));
  }
}

/**
 * Implements hook_xmlsitemap_link_alter().
 *
 * Exclude AZQS nodes that have an external link (az_link) set.
 */
function az_seo_xmlsitemap_link_alter(array &$link) {
  $check_types = ['az_event', 'az_news', 'az_person'];

  if (in_array($link['subtype'], $check_types)) {
    $node = \Drupal::entityTypeManager()->getStorage('node')->load($link['id']);

    if (!empty($node->field_az_link[0]->uri)) {
      $link['status'] = 0;
      $link['status_override'] = 1;
    }
  }
}
