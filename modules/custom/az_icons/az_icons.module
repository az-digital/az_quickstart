<?php

/**
 * @file
 * Contains az_icons.module.
 */

use Drupal\az_core\Utility\AZBootstrapColorNames;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_FORM_ID_alter().
 */
function az_icons_form_ui_icons_ckeditor5_icon_dialog_alter(array &$form, FormStateInterface $form_state, $form_id) {
  if (isset($form['icon'])) {
    $form['icon']['#after_build'][] = 'az_icons_icon_after_build';
  }

  // If an icon is saved with a new Arizona Bootstrap color name, such as
  // rain, select the Color option for the same color, which is saved as sky.
  // Without this, the Color select has no option for rain. It shows
  // "Inherit", and saving the dialog removes the icon's color.
  $old_names = array_flip(AZBootstrapColorNames::DEPRECATED_COLOR_NAMES);
  foreach (['arizona_icons', 'material_symbols'] as $pack_id) {
    $color = $form['icon']['#default_settings'][$pack_id]['color'] ?? NULL;
    if (is_string($color) && isset($old_names[$color])) {
      $form['icon']['#default_settings'][$pack_id]['color'] = $old_names[$color];
    }
  }
}

/**
 * Form #after_build callback for form icon's sub-component.
 */
function az_icons_icon_after_build(array $element, FormStateInterface $form_state) {
  // Append to field description with link to icon library.
  if (isset($element['icon_id'])) {
    $element['icon_id']['#description'] .= ' <a href="/admin/appearance/ui/icons" target="_blank">Browse the full icon library</a>.';
  }
  return $element;
}
