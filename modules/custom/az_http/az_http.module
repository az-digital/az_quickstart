<?php

/**
 * @file
 * Contains az_http.module.
 */

/**
 * Implements hook_migration_plugins_alter().
 *
 * @deprecated in az_quickstart:3.6.0 and is removed from az_quickstart:4.0.0.
 * Use az_http directly instead of relying on this hook.
 *
 * phpcs:ignore Drupal.Commenting.Deprecated.DeprecatedWrongSeeUrlFormat
 * @see https://github.com/az-digital/az_quickstart/issues/6117
 */
function az_http_migration_plugins_alter(array &$migrations) {
  // Check to see if the migration setting is enabled.
  $enabled = \Drupal::config('az_http.settings')->get('migrations.http_cached');
  // Do not swap plugins if the feature is not enabled.
  if (empty($enabled)) {
    return;
  }
  $affected_plugins = ['http', 'retry_http'];
  // Swap in custom implementation for migrations which use a HTTP fetcher.
  foreach ($migrations as &$migration) {
    $fetcher = $migration['source']['data_fetcher_plugin'] ?? '';
    if (in_array($fetcher, $affected_plugins)) {
      $migration['source']['data_fetcher_plugin'] = 'az_http';
      $id = $migration['id'] ?? 'unknown migration';
      \Drupal::logger('az_http')->warning('migration %id was dynamically updated to use the az_http data fetcher plugin. This behavior is deprecated and will be removed in Quickstart 4.0.0. Use az_http as the fetcher plugin directly if you rely on this behavior.',
      [
        '%id' => $id,
      ]);
    }
  }
}
