<?php

/**
 * @file
 * Hook implementations for az_form_embed_slate.
 *
 * Slate is a Technolutions product the university's Slate teams build forms
 * in. This module is the Slate vendor for az_form_embed: its plugin checks
 * Slate links, and its JavaScript handler loads Slate's script and styles the
 * form.
 */

use Drupal\az_form_embed_slate\SlateUrl;

/**
 * Implements hook_library_info_alter().
 *
 * Does three things:
 * - Adds Slate's handler library to the Form embed component's library, so
 *   it loads wherever the component does. Rationale: Canvas renders the
 *   component without az_form_embed's formatter, so the handler can't count
 *   on the formatter to attach it.
 * - Gives the handler the hosts and the path it may load Slate's script
 *   from. Without them, it loads none.
 * - Gives the handler the rules its loader filters the page's query
 *   parameters with. Without them, it forwards nothing.
 *
 * @see \Drupal\az_form_embed_slate\SlateUrl::getHosts()
 * @see \Drupal\az_form_embed_slate\SlateUrl::getPathPattern()
 * @see \Drupal\az_form_embed_slate\SlateUrl::getForwardingRules()
 */
function az_form_embed_slate_library_info_alter(array &$libraries, $extension) {
  if ($extension === 'az_form_embed_slate' && isset($libraries['slate'])) {
    $libraries['slate']['drupalSettings']['azFormEmbed']['hosts']['slate'] = SlateUrl::getHosts();
    $libraries['slate']['drupalSettings']['azFormEmbed']['pathPattern']['slate'] = SlateUrl::getPathPattern();
    $libraries['slate']['drupalSettings']['azFormEmbed']['forwarding']['slate'] = SlateUrl::getForwardingRules();
  }
  // Drupal registers every component's library under core, with the
  // component's id in the name.
  if ($extension === 'core' && isset($libraries['components.az_quickstart--form-embed'])) {
    $libraries['components.az_quickstart--form-embed']['dependencies'][] = 'az_form_embed_slate/slate';
  }
}
