<?php

/**
 * @file
 * Hook implementations for az_form_embed_trellis.
 *
 * Trellis is the university's Salesforce platform, and its forms are built
 * in FormAssembly. This module is the Trellis vendor for az_form_embed: its
 * plugin checks Trellis form links, and its JavaScript handler loads
 * FormAssembly's script and styles the form.
 */

/**
 * Implements hook_library_info_alter().
 *
 * Adds Trellis's handler library to the Form embed component's library, so
 * it loads wherever the component does. Rationale: Canvas renders the
 * component without az_form_embed's formatter, so the handler can't count on
 * the formatter to attach it.
 */
function az_form_embed_trellis_library_info_alter(array &$libraries, $extension) {
  // Drupal registers every component's library under core, with the
  // component's id in the name.
  if ($extension === 'core' && isset($libraries['components.az_quickstart--form-embed'])) {
    $libraries['components.az_quickstart--form-embed']['dependencies'][] = 'az_form_embed_trellis/trellis';
  }
}
