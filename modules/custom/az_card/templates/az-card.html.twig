{#
/**
 * @file
 * Theme implementation to display an AZ Card.
 *
 * Available variables:
 * - attributes: Card element attributes.
 * - media: The media field of a card.
 * - title: The title field of a card.
 * - body: The body field of a card.
 * - link: The link field on a card.
 * - link_url: The link URL only.
 * - title_style: The title style to use.
 * - title_alignment: The title alignment to use.
 * - title_level: The heading level to use.
 * - title_display: The title text display size to use.
 * - title_classes: Additional classes for the card title.
 * - body_classes: Additional classes for the card body.
 * - title_link_stretched: Whether the link in the title covers the card.
 * - image_only: Whether the card is an image tile: a square image with the
 *   title on it, and nothing under the image.
 * - fit_content: Whether the card is only as tall as its content. By default,
 *   a card is as tall as the tallest card in its row.
 * - icon: A Material Symbols icon name, shown when the card has no media.
 *
 * @ingroup themeable
 */
#}

{% macro title_link(title, link_url, has_link, stretched) %}
  {% if has_link %}
    <a href="{{ link_url }}" class="text-reset{{ stretched ? ' stretched-link text-decoration-none' }}">{{ title }}</a>
  {% else %}
    {{ title }}
  {% endif %}
{% endmacro %}
{% import _self as card %}

{% if not fit_content %}
  {% set attributes = attributes.addClass('h-100') %}
{% endif %}
{% set has_link = link_url is not empty and link|render %}

<div{{ attributes }}>
  {% if media %}
    <div class="{{ image_only ? 'ratio ratio-1x1' : 'position-relative' }} overflow-hidden">
      {{ media }}
      {% if title and title_style == 'title-on-image' %}
        <div class="card-img-overlay p-0 d-flex flex-column">
          <{{ title_level }} class="fw-bold mt-auto card-title text-bg-gradient-blue text-white mb-0 p-4 {{ image_only ? 'h-50 d-flex align-items-end' : 'pt-8' }} {{ title_alignment }} {{ title_display }} {{ title_classes|join(' ') }}">
            {{ card.title_link(title, link_url, has_link, title_link_stretched) }}
          </{{ title_level }}>
        </div>
      {% endif %}
    </div>
  {% endif %}
  {% if image_only %}
    {# An image tile shows nothing under the image. Its title holds the link. #}
  {% elseif title_style == 'title-on-image' and body['#text'] == '' and (link['#title'] == '' or 'visually-hidden' in link['#attributes']['class'] ) %}
    <div class="d-flex flex-column">
      {% if link|render %}
        {% if 'visually-hidden' in link['#attributes']['class'] and 'stretched-link' in link['#attributes']['class'] %}
          <div class="mt-auto">
            <a href="{{ link['#url'] }}" class="stretched-link" aria-label="{{ link['#title'] }}"></a>
          </div>
        {% else %}
          <div class="mt-auto">{{ link }}</div>
        {% endif %}
      {% endif %}
    </div>
  {% else %}
    <div class="card-body d-flex flex-column {{ body_classes|join(' ') }}">
      {% if icon and not media %}
        <span class="card-icon material-symbols-rounded fw-light" style="font-variation-settings: 'FILL' 0;" aria-hidden="true">{{ icon }}</span>
      {% endif %}
      {% if title and title_style == 'default' %}
        <{{ title_level }} class="fw-bold mt-0 mb-2 card-title {{ title_alignment }} {{ title_display }} {{ title_classes|join(' ') }}">
          {{ card.title_link(title, link_url, has_link, false) }}
        </{{ title_level }}>
      {% endif %}
      {% if body['#text'] %}
        <div class="card-text">{{ body }}</div>
      {% endif %}
      {% if link %}
        <div class="mt-auto">{{ link }}</div>
      {% endif %}
    </div>
  {% endif %}
</div>
