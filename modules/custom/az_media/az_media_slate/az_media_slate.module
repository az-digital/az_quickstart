<?php

/**
 * @file
 * Hook implementations for az_media_slate.
 *
 * This module lets an editor put a Slate form on a page. Slate is a
 * Technolutions product the university's Slate team builds forms in. The
 * editor pastes the form's share link, for example
 * https://uaz.technolutions.net/register/?id=<form GUID>, into a Slate Form
 * media item, then places it through the Media Library.
 *
 * On the page, Slate's embed script fetches the form and writes it into an
 * empty div we render. The work is split across three places:
 * - \Drupal\az_media_slate\SlateUrl checks the pasted link and builds the
 *   URLs we need from it.
 * - AzMediaRemoteSlateFormatter renders that div, or a placeholder while
 *   someone is editing.
 * - js/az-media-slate.js loads Slate's script, styles the form with Arizona
 *   Bootstrap, and shows a fallback link if the form doesn't arrive.
 *
 * @see https://knowledge.technolutions.net/docs/embedding-forms
 */

/**
 * Implements hook_theme().
 */
function az_media_slate_theme($existing, $type, $theme, $path) {
  return [
    'az_media_slate' => [
      'variables' => [
        // Attributes for the div Slate writes the form into, including the id
        // we pass to Slate as the embed's "div" parameter.
        'attributes' => [],
        // The form's plain URL, for the fallback link. Don't pass the embed
        // URL here: Slate answers that one with JavaScript, not a page.
        'canonical_url' => NULL,
      ],
      'template' => 'az-media-slate',
    ],
  ];
}
